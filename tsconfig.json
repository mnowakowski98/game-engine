{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "module": "NodeNext",
        "moduleResolution": "nodenext",
        "target": "ESNext",
        "allowJs": true,
        "sourceMap": true,
        "outDir": "dist/",
        "declaration": true
    },
    "include": [
        "**/*.ts",
        "**/index.ts"
    ],
    "exclude": [
        "node_modules/",
        "dist/"
    ]
}